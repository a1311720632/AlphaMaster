# 复制为 .env 并填入真实值（.env 已在 .gitignore 中，不会上传 GitHub）
#
# MT5 实盘 / 数据拉取（run.py、live_trade.py、download_full_history.py 等）
MT5_LOGIN=12345678
MT5_PASSWORD=your_password_here
MT5_SERVER=YourBroker-Demo

# OKX 加密实盘（自动驾驶第四步，仅 testnet / live 模式需要；paper 模式留空即可）
# OKX_SANDBOX=true 走 demo trading（假币），false 走真实资金。
OKX_API_KEY=your_okx_api_key_here
OKX_SECRET_KEY=your_okx_secret_key_here
OKX_PASSPHRASE=your_okx_passphrase_here
OKX_SANDBOX=true
